# Keys of the ~/.preloop-oss/.env that Preloop's own installer generates (RUNBOOK §2.1).
# Reference only — the installer writes the real file. Never commit the real values.
PRELOOP_VERSION=0.15.0
SECRET_KEY=<generated-by-installer>
POSTGRES_PASSWORD=<generated-by-installer>
PRELOOP_URL=http://localhost:3000
ALLOWED_ORIGINS=<set-by-installer>
REGISTRATION_ENABLED=<set-by-installer>
PRELOOP_BOOTSTRAP_TOKEN=<generated-by-installer>
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
