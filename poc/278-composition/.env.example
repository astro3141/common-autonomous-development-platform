# Host-side variables for docker/compose.poc.yaml. Both are optional; the defaults are
# relative to docker/ and work in a fresh clone. Copy to docker/.env to override.

# Directory mounted as /work in the agent (this poc/278-composition directory).
POC_HOST_DIR=..

# #280 research workspace mounted as /research. Not part of #278; empty placeholder by default.
RESEARCH_HOST_DIR=../evidence/research
